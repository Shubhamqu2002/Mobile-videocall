{
  "name": "webrtc-poc",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "puppeteer": "24.31.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "playwright": "1.56.1",
    "vite": "7.1.12"
  }
}
